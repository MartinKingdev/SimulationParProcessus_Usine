						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// Vérifier s'il y a assez d'agents dans le bloc Delay
int agentsDisponibles = attenteStockDepart.size();
int agentsALiberer = Math.min(16, agentsDisponibles);

// Boucle pour libérer le nombre d'agents voulu
for (int i = 0; i < agentsALiberer; i++) {
    // Récupérer le premier agent actuellement dans le delay
    Palette agentAFormater = attenteStockDepart.get(i); 
    
    // Forcer la sortie immédiate de cet agent
    attenteStockDepart.stopDelay(agentAFormater);
}]]></Code>
							</Value>
